# =========================================================
# SIGNSPEAK ENVIRONMENT VARIABLES
# =========================================================

# Flask
FLASK_APP=app.py
FLASK_ENV=development
FLASK_DEBUG=1

# Application
APP_NAME=SignSpeak
APP_HOST=127.0.0.1
APP_PORT=5000

# Security
SECRET_KEY=change-this-to-a-random-secret-key

# Database
DATABASE_URL=sqlite:///signspeak.db

# Camera / Detection
CAMERA_ENABLED=true

# Sign Language Detection
DETECTION_ENABLED=true
DETECTION_CONFIDENCE=0.70

# API
API_VERSION=v1